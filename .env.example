# Opcional: DATABASE_URL tiene prioridad sobre DB_*. Mantén los parámetros SSL de la conexión.
# DATABASE_URL=postgresql://your_neon_user:your_neon_password@your-neon-host.neon.tech/neondb?sslmode=require&channel_binding=require
DB_NAME=neondb
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432
DB_SSLMODE=require
DB_CHANNEL_BINDING=require

JWT_SECRET_KEY=replace_with_access_secret
JWT_REFRESH_SECRET_KEY=replace_with_refresh_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

JWT_RESET_SECRET_KEY=replace_with_reset_secret
RESET_CODE_TTL_MINUTES=30
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_LOCKOUT_MINUTES=15

EMAIL_ENABLED=false
EMAIL_FROM_NAME=Telemedicina - Hospital San Juan de Dios
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@telemedicina.com

CORS_ORIGINS=http://localhost:4200

# Almacenamiento de documentos y recetas. Para R2, cambia STORAGE_BACKEND a r2
# y configura endpoint, bucket y credenciales en el entorno del servidor.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=storage_documents
STORAGE_PUBLIC_BASE_URL=http://localhost:8000
# Variables MINIO_* también se usan para R2 y otros backends S3 compatibles.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=telemedicina-documentos
MINIO_SECURE=false
DOCUMENTO_URL_EXPIRACION=900

# CU16 Recetas digitales (sin secretos reales; generar fuera del repositorio)
# Clave privada Ed25519 activa en Base64 estándar (32 bytes)
PRESCRIPTION_SIGNING_PRIVATE_KEY_BASE64=replace_with_ed25519_private_key_base64
# Identificador de la clave activa (permite rotación)
PRESCRIPTION_SIGNING_KEY_ID=prescriptions-2026-01
# Anillo de claves públicas {key_id: public_key_base64} (activa + históricas)
PRESCRIPTION_VERIFICATION_KEYS_JSON={"prescriptions-2026-01": "replace_with_ed25519_public_key_base64"}
# Secreto HMAC-SHA256 para anonimizar IP en telemetría de validación pública
PRESCRIPTION_TELEMETRY_HMAC_KEY=replace_with_telemetry_hmac_secret
# Base pública para la URL de validación embebida en el QR
PRESCRIPTION_PUBLIC_BASE_URL=http://localhost:8000
PRESCRIPTION_DEFAULT_VALIDITY_DAYS=90
# Máximo efectivo = min(90, global validado, clínica). La clínica solo reduce.
# Valores <1 o >90 son error explícito de configuración (nunca silenciosos).
# Proxies de confianza para X-Forwarded-For (vacío = no confiar en ninguno).
# Si request.client.host está en la lista, se acepta el primer IP válido del
# encabezado; si no, se ignora y se usa request.client.host.
TRUSTED_PROXY_IPS=

# CU19 Pagos en línea (Stripe Sandbox) y comprobantes digitales
# Deja STRIPE_SECRET_KEY vacía para usar el modo demostración (sin cobros reales).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_CURRENCY=bob
STRIPE_TIMEOUT_SECONDS=20
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_DEFAULT_AMOUNT=50.00
PAYMENT_PUBLIC_BASE_URL=http://localhost:8000
PAYMENT_WEB_SUCCESS_URL=http://localhost:4200/pagos/resultado
PAYMENT_WEB_CANCEL_URL=http://localhost:4200/mis-citas
PAYMENT_MOBILE_SUCCESS_URL=http://localhost:8000/pagos/retorno?estado=exito
PAYMENT_MOBILE_CANCEL_URL=http://localhost:8000/pagos/retorno?estado=cancelado
PAYMENT_SESSION_TTL_MINUTES=30

# CU31 Suscripciones de planes (Stripe Checkout)
# La URL debe apuntar al frontend desplegado; {CHECKOUT_SESSION_ID} es reemplazado por Stripe.
SUBSCRIPTION_WEB_SUCCESS_URL=http://localhost:4200/admin/suscripcion?checkout=success&session_id={CHECKOUT_SESSION_ID}
SUBSCRIPTION_WEB_CANCEL_URL=http://localhost:4200/admin/suscripcion?checkout=cancelled

# CU36 Excedentes: el webhook utiliza un secreto Stripe propio, distinto de CU19/CU31.
# STRIPE_SECRET_KEY debe ser sk_test_; CU36 fija la moneda BOB sin usar STRIPE_CURRENCY.
STRIPE_CU36_WEBHOOK_SECRET=
BILLING_CU36_SUCCESS_URL=http://localhost:4200/admin/consumo
BILLING_CU36_CANCEL_URL=http://localhost:4200/admin/consumo
BILLING_CU36_WORKER_ENABLED=true

# CU22 Interpretación de reportes (Groq Structured Outputs)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=1000
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_TRANSCRIPTION_TIMEOUT_SECONDS=30

# CU17: push opcional; generar la clave Fernet fuera del repositorio y proteger
# el archivo de cuenta de servicio. Vacío deshabilita el registro push (503).
CU17_FCM_PROJECT_ID=
CU17_FCM_SERVICE_ACCOUNT_FILE=
CU17_DEVICE_TOKEN_KEY=
# Mapa JSON de id_clinica a id_usuario de servicio con rol SISTEMA activo.
CU17_SYSTEM_USER_IDS_JSON={}

# =====================================================================
# CU14: Teleconsultas y Videoconsultas WebRTC
# =====================================================================
# Servidores STUN (separados por coma para redundancia)
WEBRTC_STUN_SERVER=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Servidor TURN (opcional en desarrollo; requerido en producción para atravesar NAT simétrico / 4G)
# Formato: turn:tu-servidor-turn.com:3478?transport=udp
WEBRTC_TURN_SERVER=
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Límites operativos de sesión de teleconsulta
TELECONSULTA_MAX_DURATION_MINUTES=60
TELECONSULTA_HEARTBEAT_TIMEOUT_SECONDS=45
TELECONSULTA_RECORDING_ENABLED=false

# =====================================================================
# CU20: Notificaciones y Recordatorios Multicanal (Push / Email / SMS)
# =====================================================================
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@telemedicina.com
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
OUTBOX_WORKER_ACTIVO=true
OUTBOX_WORKER_INTERVALO_SEGUNDOS=30
