DB_NAME=neondb
DB_USER=your_neon_user
DB_PASSWORD=your_neon_password
DB_HOST=your-neon-host.neon.tech
DB_PORT=5432

JWT_SECRET_KEY=replace_with_access_secret
JWT_REFRESH_SECRET_KEY=replace_with_refresh_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

JWT_RESET_SECRET_KEY=replace_with_reset_secret
RESET_CODE_TTL_MINUTES=30
RESET_CODE_MAX_ATTEMPTS=5
RESET_CODE_LOCKOUT_MINUTES=15

EMAIL_ENABLED=false
EMAIL_FROM_NAME=Telemedicina - Hospital San Juan de Dios
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=no-reply@telemedicina.com

CORS_ORIGINS=http://localhost:4200

# CU16 Recetas digitales (sin secretos reales; generar fuera del repositorio)
# Clave privada Ed25519 activa en Base64 estándar (32 bytes)
PRESCRIPTION_SIGNING_PRIVATE_KEY_BASE64=replace_with_ed25519_private_key_base64
# Identificador de la clave activa (permite rotación)
PRESCRIPTION_SIGNING_KEY_ID=prescriptions-2026-01
# Anillo de claves públicas {key_id: public_key_base64} (activa + históricas)
PRESCRIPTION_VERIFICATION_KEYS_JSON={"prescriptions-2026-01": "replace_with_ed25519_public_key_base64"}
# Secreto HMAC-SHA256 para anonimizar IP en telemetría de validación pública
PRESCRIPTION_TELEMETRY_HMAC_KEY=replace_with_telemetry_hmac_secret
# Base pública para la URL de validación embebida en el QR
PRESCRIPTION_PUBLIC_BASE_URL=http://localhost:8000
PRESCRIPTION_DEFAULT_VALIDITY_DAYS=90
# Máximo efectivo = min(90, global validado, clínica). La clínica solo reduce.
# Valores <1 o >90 son error explícito de configuración (nunca silenciosos).
# Proxies de confianza para X-Forwarded-For (vacío = no confiar en ninguno).
# Si request.client.host está en la lista, se acepta el primer IP válido del
# encabezado; si no, se ignora y se usa request.client.host.
TRUSTED_PROXY_IPS=

# CU22 Interpretación de reportes (Groq Structured Outputs)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=10
GROQ_MAX_OUTPUT_TOKENS=1000
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_TRANSCRIPTION_TIMEOUT_SECONDS=30
